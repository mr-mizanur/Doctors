# Copy to .env.local and replace the placeholders; NEVER commit .env.local
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGODB_DB=doctor-tracker
# The Express API base address (server-only; never NEXT_PUBLIC)
BACKEND_URL=http://localhost:5000
# Admin access is granted by database field role="admin"; never by public env.
